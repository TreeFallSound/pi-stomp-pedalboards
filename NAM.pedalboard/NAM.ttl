    ingen:head <stereo/inL> .

_:b7
    ingen:tail <neural_amp_modeler_lv2/output> ;
    ingen:head <cabsim/In> .

_:b8
    ingen:tail <cabsim/Out> ;
    ingen:head <reverb_1/inputl> .

_:b9
