<mud>
    ingen:canvasX 1007.0 ;
    ingen:canvasY 635.0 ;
    ingen:enabled false ;
    ingen:polyphonic false ;
    lv2:microVersion 0 ;
    lv2:minorVersion 2 ;
    mod:builderVersion 0 ;
    mod:releaseNumber 0 ;
    lv2:port <mud/lv2_audio_in_1> ,
             <mud/lv2_audio_out_1> ,
             <mud/mix> ,
             <mud/filter> ,
             <mud/lfo> ,
             <mud/:bypass> ;
    lv2:prototype <http://remaincalm.org/plugins/mud> ;
    pedal:instanceNumber 4 ;
    pedal:preset <http://remaincalm.org/plugins/mud#preset003> ;
    a ingen:Block .

<mud/lv2_audio_in_1>
    a lv2:AudioPort ,
        lv2:InputPort .

<mud/lv2_audio_in_1>
    a lv2:AudioPort ,
        lv2:OutputPort .

<mud/mix>
    ingen:value 50.000000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<mud/filter>
    ingen:value 50.000000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<mud/lfo>
    ingen:value 0.000000 ;
    a lv2:ControlPort ,
        lv2:InputPort .

<mud/:bypass>
    ingen:value 1 ;
    midi:binding [
        midi:channel 13 ;
        midi:controllerNumber 62 ;
        a midi:Controller ;
    ] ;
    a lv2:ControlPort ,
        lv2:InputPort .

